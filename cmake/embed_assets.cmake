# Writes OUT (a C file) holding the tablet's fonts and the WXPlane icon's picture as byte arrays: xpt_asset_<name>[] and xpt_asset_<name>_size.
# Run with: cmake -DSRC=<repo root> -DOUT=<file.c> -P embed_assets.cmake
set(names plex_regular plex_semibold plex_bold mono wxlogo tzones basemap logo icons)
set(files third_party/fonts/IBMPlexSans-Regular.ttf third_party/fonts/IBMPlexSans-SemiBold.ttf third_party/fonts/IBMPlexSans-Bold.ttf
          third_party/fonts/JetBrainsMono-Regular.ttf assets/wxplane_stacked.rgba third_party/naturalearth/tzones.bin third_party/naturalearth/basemap.bin assets/xptablet_logo.rgba assets/icons.rgba)
set(body "/* generated by cmake/embed_assets.cmake - do not edit */\n")
list(LENGTH names n)
math(EXPR last "${n} - 1")
foreach(i RANGE ${last})
  list(GET names ${i} name)
  list(GET files ${i} file)
  file(READ "${SRC}/${file}" hex HEX)
  string(LENGTH "${hex}" hexlen)
  math(EXPR size "${hexlen} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "((0x..,){32})" "\\1\n" bytes "${bytes}")
  string(APPEND body "const unsigned char xpt_asset_${name}[] = {\n${bytes}\n};\nconst unsigned int xpt_asset_${name}_size = ${size};\n")
endforeach()
file(WRITE "${OUT}.tmp" "${body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
